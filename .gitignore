common/Athena/snomed/CONCEPT_ANCESTOR.csv
common/Athena/snomed/CONCEPT_SYNONYM.csv

# HuggingFace cache — managed via HF_HOME, only track placeholders to preserve directory structure
.cache/**
!.cache/.placeholder
!.cache/huggingface/
!.cache/huggingface/.placeholder

